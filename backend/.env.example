# .env example for ai_video_platform
# Copy this to .env and fill in the values

# PostgreSQL (used via Docker, but useful for local scripts)
DATABASE_URL=postgresql://postgres:password@localhost:5432/video_platform

# Redis broker
REDIS_URL=redis://localhost:6379/0

# OpenAI API key
OPENAI_API_KEY=your-openai-key-here

# ElevenLabs API key
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# AWS credentials for S3 storage
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_DEFAULT_REGION=us-east-1

# Stripe secret key (for production use test key first)
STRIPE_SECRET_KEY=sk_test_...
